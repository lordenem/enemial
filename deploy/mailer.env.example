# Copy to ~/enemial/.env on the server and fill in. Never commit the real one.

# The company mailbox the form sends FROM (GoDaddy email).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_USER=nmampare@enemialtechnologies.com
SMTP_PASSWORD=

# Where enquiries go, comma-separated.
CONTACT_TO=nmampare@enemialtechnologies.com,nmampare@gmail.com

# Signs the form's load-time token. Generate with: openssl rand -hex 32
MAILER_SECRET=
